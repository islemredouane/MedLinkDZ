{
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/annonce/:id",
      "destination": "/annonce"
    },
    {
      "source": "/profil",
      "destination": "/profil/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ]
}
